# ── Telegram ──────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random secret (at least 16 chars) to authenticate webhook requests
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram chat ID from @userinfobot (the only chat that gets served)
TELEGRAM_OWNER_CHAT_ID=

# ── Strava ────────────────────────────────────────────
# API App credentials from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Random secret token (at least 16 chars) for webhook subscription verification
STRAVA_VERIFY_TOKEN=
# Numeric athlete ID on Strava
STRAVA_ATHLETE_ID=
STRAVA_API_BASE=https://www.strava.com/api/v3
# Populated after running scripts/setup_strava_webhook.py
STRAVA_SUBSCRIPTION_ID=

# ── Gemini ────────────────────────────────────────────
# API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_ORCHESTRATOR=gemini-3.1-flash-lite
GEMINI_MODEL_ANALYST=gemini-3.5-flash
GEMINI_MODEL_CONVERSATION=gemini-3.5-flash
GEMINI_DAILY_CALL_CAP=200

# ── Storage ───────────────────────────────────────────
# Postgres connection string (Neon or Supabase)
DATABASE_URL=
# Upstash Redis REST credentials (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Upstash QStash credentials (https://upstash.com/docs/qstash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── App & Security ────────────────────────────────────
# Public HTTPS URL of the deployed application (or ngrok URL for local dev)
APP_URL=
# 32-byte URL-safe base64 Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Internal secret (at least 16 chars) for securing worker endpoints & cron
# python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=
SESSION_TTL_SECONDS=1800
LOG_LEVEL=INFO
STRAVA_LLM_ANALYSIS_ENABLED=true
STRAVA_CACHE_TTL_DAYS=7
BRIEFING_MIN_DURATION_SECONDS=0
BRIEFING_MIN_DISTANCE_METERS=0

# ── Athlete Profile (Defaults) ────────────────────────
MAX_HR=
RESTING_HR=
LTHR=
BODYWEIGHT_KG=
WEIGHT_UNIT=kg
DISTANCE_UNIT=km
TRAINING_GOAL=Hybrid — lifting + running, general fitness
